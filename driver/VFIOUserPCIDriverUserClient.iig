#ifndef OPENPCI_DRIVER_CONNECTION_IIG
#define OPENPCI_DRIVER_CONNECTION_IIG

#include <DriverKit/IOUserClient.iig>
#include <DriverKit/IOInterruptDispatchSource.iig>

// Each connection has its own negotiated generation and resource lifetime.
class VFIOUserPCIDriverUserClient : public IOUserClient {
public:
    kern_return_t Start(IOService *provider) override;
    kern_return_t Stop(IOService *provider) override;
    void free() override LOCALONLY;

    // DriverKit enters through ExternalMethod for both sync and async selectors.
    kern_return_t ExternalMethod(uint64_t selector,
                                 IOUserClientMethodArguments *arguments,
                                 const IOUserClientMethodDispatch *dispatch,
                                 OSObject *target, void *reference) override;
    kern_return_t CopyClientMemoryForType(uint64_t type, uint64_t *options,
                                         IOMemoryDescriptor **memory) override;

    // The dispatch-source action delivers a vector. DriverKit supplies the
    // inherited AsyncCompletion RPC used to notify an application waiting on it.
    virtual void DeliverVector(OSAction *action, uint64_t count, uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred);
    void AsyncCompletion(OSAction *action, IOReturn status,
                         const IOUserClientAsyncArgumentsArray data,
                         uint32_t count) override;
};

#endif
